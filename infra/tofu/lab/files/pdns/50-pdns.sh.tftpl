#!/bin/bash
# greenboot required check on dns01: after an update, the lab zone must answer.
# Failing makes greenboot boot back into the previous deployment. Up to 10 min, so
# a slow start (network back late after a power cut) isn't mistaken for a broken
# update. Self-contained: no helper an older deployment might lack.
deadline=$((SECONDS + 600))
while [ $SECONDS -lt $deadline ]; do
  dig +short +time=2 +tries=1 @127.0.0.1 ${zone} SOA | grep -q . && exit 0
  sleep 5
done
echo "${zone} SOA did not answer on 127.0.0.1 within 10 min" >&2
exit 1
