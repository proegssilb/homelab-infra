# Written by Tofu (tofu/lab/aptcache01.tf). Read after the image's stock acng.conf,
# which supplies the Debian, Ubuntu and Debian-security Remap rules this relies on.

CacheDir: /var/cache/apt-cacher-ng
Port: 3142

# IPv4 only: the lab has no routed IPv6, though repo hosts publish AAAA records.
ConnectProto: v4

# The container's resolv.conf is the VM's: systemd-resolved's stub (see the Quadlet).
EvDnsResolvConf: /etc/resolv.conf

# No DNS cache of its own: in 3.7.x a cached lookup is never checked for expiry, so
# one failed lookup sticks until restart. resolved caches instead.
DnsCacheSeconds: 0

# Allowlist: serve only repositories that match a Remap rule. Any other plain-HTTP
# URL is refused, so the cache can't be used as a general web proxy.
ForceManaged: 1
%{ for r in remaps ~}
Remap-${r.name}: ${r.match} ; ${r.backend}
%{ endfor ~}

# HTTPS repositories can't be cached; tunnel (CONNECT) only to these hosts.
PassThroughPattern: ^(${join("|", [for h in passthrough : replace(h, ".", "\\.")])}):443$
