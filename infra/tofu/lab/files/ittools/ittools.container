# Quadlet: IT Tools (stateless web app), behind proxy01 as tools.<domain>.
[Unit]
Description=IT Tools
Wants=network-online.target
After=network-online.target
# Keep retrying (every 10 s) instead of hitting systemd's start limit and giving up.
StartLimitIntervalSec=0

[Container]
ContainerName=ittools
Image=docker.io/corentinth/it-tools:2024.10.22-7ca5933
PublishPort=8080:80

[Service]
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
