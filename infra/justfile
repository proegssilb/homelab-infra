# infra/justfile — public interface for homelab IaC operations.
#
# Requires: opentofu, ansible, just
# All secrets via environment variables — see tofu/*/versions.tf for the list.
#
# Usage:
#   just --list          show all public targets
#   just bootstrap       day-1: bring up everything from nothing

set shell := ["bash", "-euo", "pipefail", "-c"]

# ── Internal helpers ───────────────────────────────────────────────────────────

# Init a tofu state directory, injecting the Garage endpoint from the environment.
# GARAGE_ENDPOINT must be set (e.g. http://blade02.home.domain:3900).
_tofu-init state:
    cd tofu/{{state}} && tofu init -backend-config="endpoint=${GARAGE_ENDPOINT}"

# ── Day 1 ──────────────────────────────────────────────────────────────────────

# Bring up everything from nothing, in dependency order. Also idempotent —
# safe to rerun against a partially-up lab.
bootstrap:
    just galaxy-install
    just garage
    just cluster-up platform
    just cluster-up pets

# Install Ansible Galaxy collections declared in requirements.yml into galaxy/ (vendored).
galaxy-install:
    cd ansible && ansible-galaxy collection install -r requirements.yml -p galaxy/

# Bring up all VMs in a named cluster/group.
cluster-up cluster:
    just _tofu-init {{cluster}}
    cd tofu/{{cluster}} && tofu apply -auto-approve -parallelism=2
    just tune-all {{cluster}}

# ── Day 2 ──────────────────────────────────────────────────────────────────────

# Rebuild a single node within a cluster.
node-rebuild vm cluster:
    cd tofu/{{cluster}} && tofu apply -auto-approve -target=module.vm["{{vm}}"]
    just tune {{vm}}

# Rebuild a lone VM (no join step).
vm-rebuild vm state="pets":
    cd tofu/{{state}} && tofu apply -auto-approve -target=module.vm["{{vm}}"]
    just tune {{vm}}

# ── OS tuning ──────────────────────────────────────────────────────────────────

# Run baseline OS tuning against a single host.
tune host:
    cd ansible && ansible-playbook -l {{host}} site.yml

# Run baseline OS tuning against all hosts in a group.
tune-all group:
    cd ansible && ansible-playbook -l {{group}} site.yml

# Configure Garage on blade02 (run before tofu init).
garage:
    cd ansible && ansible-playbook -l bootstrap site.yml

# ── Tofu helpers ───────────────────────────────────────────────────────────────

# Run tofu plan for a state group (no changes applied).
plan state:
    just _tofu-init {{state}}
    cd tofu/{{state}} && tofu plan -parallelism=2

# Destroy all VMs in a state group. Requires confirmation.
destroy state:
    cd tofu/{{state}} && tofu destroy -parallelism=2

# ── Database ───────────────────────────────────────────────────────────────────

# Force-reset all app DB user passwords to current vault values.
# Use when 'just tune pg01' doesn't fix a credential mismatch.
# Prereq: roles must already exist — run 'just tune pg01' first if they don't.
fix-db-passwords:
    cd ansible && ansible-playbook fix-db-passwords.yml

# ── Quality ────────────────────────────────────────────────────────────────────

# Optional tooling for the advisory sections. ansible-lint must be installed
# *with* the collections it lints against — a bare install ships only
# ansible-core and reports every community.general module as unknown:
#   uv tool install --with ansible ansible-lint
#   uv tool install yamllint
#
# Validate + lint the tree. Hard-fails only on what would break a real run.
lint:
    #!/usr/bin/env bash
    set -uo pipefail
    rc=0

    echo "── tofu validate ─────────────────────────────────────────────"
    for d in platform pets; do
      # -backend=false keeps this offline; `just plan` re-inits the real
      # Garage backend on its next run, so nothing is left broken.
      if ( cd tofu/"$d" && tofu init -backend=false -input=false >/dev/null \
           && tofu validate ); then
        echo "  $d: ok"
      else
        echo "  $d: FAILED"; rc=1
      fi
    done

    echo "── ansible syntax-check ──────────────────────────────────────"
    # Unmatched host patterns for not-yet-provisioned groups are expected
    # and are warnings, not errors.
    ( cd ansible && ansible-playbook site.yml --syntax-check ) || rc=1

    echo "── tofu fmt (advisory) ───────────────────────────────────────"
    # *.tf only, never *.tfvars — those hold plaintext secrets and -diff
    # would print them straight to the terminal.
    for d in platform pets; do
      ( cd tofu/"$d" && tofu fmt -check -diff -- *.tf ) || true
    done

    echo "── ansible-lint (advisory) ───────────────────────────────────"
    if command -v ansible-lint >/dev/null; then
      ( cd ansible && ansible-lint --offline --format=pep8 site.yml ) || true
    else
      echo "  skipped: ansible-lint not installed"
    fi

    echo "── yamllint (advisory) ───────────────────────────────────────"
    if command -v yamllint >/dev/null; then
      ( cd ansible && yamllint -f parsable site.yml inventory/ roles/ ) || true
    else
      echo "  skipped: yamllint not installed"
    fi

    if [ "$rc" -ne 0 ]; then echo; echo "lint: FAILED"; else echo; echo "lint: ok"; fi
    exit "$rc"

# Idempotent: vars already holding real ciphertext are never rotated, so this
# is safe to rerun. Run after adding new wiring, before the first bootstrap.
#
# Generate + vault-encrypt every REPLACE_ME secret stub in the inventory.
fill-vault-stubs:
    ./scripts/fill-vault-stubs.py

# ── Inventory ──────────────────────────────────────────────────────────────────

# List hosts visible via the dynamic inventory.
_inventory-list:
    ansible-inventory --list | jq 'keys'

# Graph the inventory groups.
_inventory-graph:
    ansible-inventory --graph
