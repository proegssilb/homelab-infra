---
# Copy this file to local.yml and fill in your values.
# local.yml is gitignored — never commit it.

# Short hostnames of the Proxmox cluster nodes (no domain suffix).
# (homelab_domain is site-wide — set it in group_vars/all/local.yml instead.)
homelab_proxmox_nodes:
  - pxmx01
  - pxmx02
  - pxmx03
  - pxmx04
  - pxmx05

# Email for Let's Encrypt account registration and expiry notices.
certbot_email: you@example.com
