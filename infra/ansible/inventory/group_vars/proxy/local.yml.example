---
# Copy this file to local.yml and fill in your values.
# local.yml is gitignored — never commit it.

# Virtual IP for the keepalived VRRP instance (CIDR, e.g. 192.168.1.10/24).
# Must match PROXMOX_KEEPALIVED_VIP in .env.
keepalived_vip: "192.168.1.10/24"

# Base domain for all homelab services (e.g. home.example.com).
homelab_domain: i.example.com

# Short hostnames of the Proxmox cluster nodes (no domain suffix).
homelab_proxmox_nodes:
  - pxmx01
  - pxmx02
  - pxmx03
  - pxmx04
  - pxmx05

# Email for Let's Encrypt account registration and expiry notices.
certbot_email: you@example.com
