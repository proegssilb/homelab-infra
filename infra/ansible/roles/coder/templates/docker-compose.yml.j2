---
# Managed by Ansible — do not edit manually
# The database is on coderdb (roles/postgresql via group coder_postgres).
# No Docker socket in here: workspaces are Proxmox VMs, and the socket would
# hand this container root on the host.
services:
  coder:
    image: ghcr.io/coder/coder:{{ coder_version }}
    restart: unless-stopped
    ports:
      - "{{ coder_port }}:7080"
      - "{{ coder_prometheus_port }}:2112"
    environment:
      CODER_PG_CONNECTION_URL: "postgresql://coder:{{ coder_db_password | trim }}@{{ coder_db_host }}/coder?sslmode=disable"
      CODER_HTTP_ADDRESS: "0.0.0.0:7080"
      CODER_ACCESS_URL: "{{ coder_access_url }}"
      CODER_TELEMETRY_ENABLE: "false"
      CODER_PROMETHEUS_ENABLE: "true"
      CODER_PROMETHEUS_ADDRESS: "0.0.0.0:2112"
      # Coder ships a default GitHub OAuth app (login via coder.com's app).
      # Off: logins go through Authentik, which limits them to coder-users.
      CODER_OAUTH2_GITHUB_DEFAULT_PROVIDER_ENABLE: "false"
{% if coder_oidc_issuer_url | length > 0 %}
      # Login through Authentik (tofu/pets/authentik_apps.tf). Password login
      # stays on for coder-admin, the Owner Ansible uses to push templates.
      CODER_OIDC_ISSUER_URL: "{{ coder_oidc_issuer_url }}"
      CODER_OIDC_CLIENT_ID: "{{ coder_oidc_client_id }}"
      CODER_OIDC_CLIENT_SECRET: "{{ coder_oidc_client_secret | trim }}"
      CODER_OIDC_SIGN_IN_TEXT: "{{ coder_oidc_sign_in_text }}"
      # offline_access gets a refresh token from Authentik. Without one Coder
      # ends the session when the access token expires (minutes), however
      # active the user is.
      CODER_OIDC_SCOPES: "openid,profile,email,offline_access"
      CODER_OIDC_ALLOW_SIGNUPS: "true"
      # Authentik runs no email-verification flow here, so its tokens carry
      # email_verified=false and Coder would refuse every login. Authentik is
      # the trust root (same call as mealie). Matching emails don't take over
      # password accounts: Coder refuses a login whose type doesn't match.
      CODER_OIDC_IGNORE_EMAIL_VERIFIED: "true"
{% endif %}
      # Read by the bpg/proxmox provider in workspace templates.
      PROXMOX_VE_ENDPOINT: "{{ coder_proxmox_endpoint }}"
      PROXMOX_VE_USERNAME: "{{ coder_proxmox_user }}"
      PROXMOX_VE_PASSWORD: "{{ coder_proxmox_password | trim }}"
      # Read by the svalabs/forgejo provider: the deploy-key proxy on proxy01
      # and Coder's token for it (not a Forgejo token).
      FORGEJO_HOST: "{{ coder_forgejo_keys_url }}"
      FORGEJO_API_TOKEN: "{{ coder_forgejo_keys_token | trim }}"
    volumes:
      - coder_home:/home/coder
      - {{ coder_data_dir }}/workspace-ssh:/etc/coder-workspaces:ro
      - {{ coder_data_dir }}/coder-templates:/coder-templates:ro

volumes:
  coder_home:
