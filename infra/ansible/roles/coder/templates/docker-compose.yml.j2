---
# Managed by Ansible — do not edit manually
services:
  coder:
    image: ghcr.io/coder/coder:{{ coder_version }}
    restart: unless-stopped
    ports:
      - "{{ coder_port }}:7080"
    environment:
      CODER_PG_CONNECTION_URL: "postgresql://coder:{{ coder_db_password | trim }}@database/coder?sslmode=disable"
      CODER_HTTP_ADDRESS: "0.0.0.0:7080"
      CODER_ACCESS_URL: "{{ coder_access_url }}"
      CODER_TELEMETRY_ENABLE: "false"
      # Read by the bpg/proxmox provider in workspace templates.
      PROXMOX_VE_ENDPOINT: "{{ coder_proxmox_endpoint }}"
      PROXMOX_VE_USERNAME: "{{ coder_proxmox_user }}"
      PROXMOX_VE_PASSWORD: "{{ coder_proxmox_password | trim }}"
      # Read by the svalabs/forgejo provider: the deploy-key proxy on proxy01
      # and Coder's token for it (not a Forgejo token).
      FORGEJO_HOST: "{{ coder_forgejo_keys_url }}"
      FORGEJO_API_TOKEN: "{{ coder_forgejo_keys_token | trim }}"
    group_add:
      - "{{ getent_group['docker'][1] }}"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - coder_home:/home/coder
      - {{ coder_data_dir }}/workspace-ssh:/etc/coder-workspaces:ro
      - {{ coder_data_dir }}/coder-templates:/coder-templates:ro
    depends_on:
      database:
        condition: service_healthy

  database:
    image: postgres:{{ coder_postgres_version }}
    restart: unless-stopped
    environment:
      POSTGRES_USER: coder
      POSTGRES_PASSWORD: "{{ coder_db_password | trim }}"
      POSTGRES_DB: coder
    volumes:
      - coder_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U coder -d coder"]
      interval: 5s
      timeout: 5s
      retries: 5

volumes:
  coder_data:
  coder_home:
