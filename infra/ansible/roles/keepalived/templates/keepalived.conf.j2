# Managed by Ansible — do not edit by hand.
# Role: keepalived

global_defs {
  router_id {{ inventory_hostname }}
  # Suppress emails on state changes (no mail daemon configured).
  enable_script_security
  script_user root
}

# Health check: poll nginx every {{ keepalived_nginx_check_interval }}s.
# If nginx is down for {{ keepalived_nginx_check_fall }} consecutive checks,
# drop this node's effective priority by {{ keepalived_nginx_check_weight | abs }},
# forcing failover to the healthy peer.
vrrp_script chk_nginx {
  script "/usr/bin/systemctl is-active --quiet nginx"
  interval {{ keepalived_nginx_check_interval }}
  fall     {{ keepalived_nginx_check_fall }}
  rise     {{ keepalived_nginx_check_rise }}
  weight   {{ keepalived_nginx_check_weight }}
}

vrrp_instance VI_1 {
  state            {{ keepalived_state }}
  interface        {{ keepalived_interface }}
  virtual_router_id {{ keepalived_router_id }}
  priority         {{ keepalived_priority }}
  advert_int       1

  garp_master_delay          {{ keepalived_garp_master_delay }}
  garp_master_repeat         {{ keepalived_garp_master_repeat }}
  garp_master_refresh        {{ keepalived_garp_master_refresh }}
  garp_master_refresh_repeat {{ keepalived_garp_master_refresh_repeat }}
  garp_lower_prio_repeat     {{ keepalived_garp_lower_prio_repeat }}

  # Unicast VRRP — avoids relying on multicast between Proxmox nodes.
  unicast_src_ip {{ ansible_default_ipv4.address }}
  unicast_peer {
{% for host in groups['proxy'] if host != inventory_hostname %}
    {{ hostvars[host]['ansible_default_ipv4']['address'] }}
{% endfor %}
  }

  authentication {
    auth_type PASS
    auth_pass {{ keepalived_auth_pass }}
  }

  virtual_ipaddress {
    {{ keepalived_vip }}
  }

  track_script {
    chk_nginx
  }

  # Log all MASTER/BACKUP/FAULT transitions to journald.
  notify /etc/keepalived/notify.sh
}
