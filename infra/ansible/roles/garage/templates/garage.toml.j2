# garage.toml — generated by Ansible. Do not edit by hand.

metadata_dir = "{{ garage_meta_dir }}"
data_dir     = "{{ garage_data_dir }}"
db_engine    = "sqlite"

replication_factor = 1

rpc_bind_addr   = "{{ garage_rpc_bind_addr }}"
rpc_public_addr = "{{ ansible_facts['default_ipv4'].address }}:3901"
rpc_secret      = "{{ garage_rpc_secret }}"

[s3_api]
s3_region     = "garage"
api_bind_addr = "{{ garage_s3_bind_addr }}"

[s3_web]
bind_addr   = "0.0.0.0:3902"
root_domain = ".web.garage.localhost"
index       = "index.html"

[admin]
api_bind_addr = "127.0.0.1:3903"
