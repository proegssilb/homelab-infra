    {
      "type": "timeseries",
      "title": "Network, physical NICs (in up, out down)",
      "description": "",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (node) (rate(proxmox_node_network_receive_total{node=~\"$node\", device=~\"nic[0-9]+|en.*|eth.*\"}[$__rate_interval]))",
          "legendFormat": "{{node}} in",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (node) (rate(proxmox_node_network_transmit_total{node=~\"$node\", device=~\"nic[0-9]+|en.*|eth.*\"}[$__rate_interval]))",
          "legendFormat": "{{node}} out",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* out"
            },
            "properties": [
              {
                "id": "custom.transform",
                "value": "negative-Y"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
