{
  "uid": "ai-firewall",
  "title": "AI firewall",
  "description": "What Coder workspaces (AI agents) try to reach and what gets stopped: egress proxy allowlist verdicts, UniFi Agents-zone drops, workspace VM firewall drops. All from Loki. Managed by Ansible (grafana role).",
  "tags": [
    "coder",
    "security",
    "firewall"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "loki",
        "label": "Logs",
        "query": "loki",
        "current": {
          "text": "Loki",
          "value": "Loki"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Egress proxy (mitmproxy on egress01): every workspace HTTP(S) connection",
      "id": 1,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Connections by allowlist verdict",
      "description": "One 'listed' or 'would refuse' per connection (allowlist.py). 'refused' = blocked: a non-public destination, or not on the list once enforce mode is on.",
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({host=\"egress01\", unit=\"docker.service\"} |= `egress listed:` [$__interval]))",
          "refId": "A",
          "legendFormat": "listed",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({host=\"egress01\", unit=\"docker.service\"} |= `egress would refuse:` [$__interval]))",
          "refId": "B",
          "legendFormat": "would refuse (shadow mode)",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({host=\"egress01\", unit=\"docker.service\"} |= `egress refused: client` [$__interval]))",
          "refId": "C",
          "legendFormat": "refused",
          "queryType": "range"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "table",
      "title": "Allowlist misses ('would refuse'): candidates for the list",
      "description": "",
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(25, sum by (dest, port) (count_over_time({host=\"egress01\", unit=\"docker.service\"} |= `egress would refuse:` | regexp `-> (?P<dest>[^ :]+):(?P<port>\\d+)` | regexp `client (?P<client>\\S+)` [$__range])))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "count"
            },
            "indexByName": {
              "dest": 0,
              "port": 1,
              "count": 2
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "count",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "table",
      "title": "Refused (non-public or enforce mode)",
      "description": "",
      "id": 4,
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(25, sum by (dest, port) (count_over_time({host=\"egress01\", unit=\"docker.service\"} |= `egress refused: client` | regexp `-> (?P<dest>[^ :]+):(?P<port>\\d+)` | regexp `client (?P<client>\\S+)` [$__range])))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "count"
            },
            "indexByName": {
              "dest": 0,
              "port": 1,
              "count": 2
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "count",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      }
    },
    {
      "type": "table",
      "title": "Top listed destinations",
      "description": "",
      "id": 5,
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(25, sum by (dest) (count_over_time({host=\"egress01\", unit=\"docker.service\"} |= `egress listed:` | regexp `-> (?P<dest>[^ :]+):(?P<port>\\d+)` | regexp `client (?P<client>\\S+)` [$__range])))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "count"
            },
            "indexByName": {
              "dest": 0,
              "count": 1
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "count",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      }
    },
    {
      "type": "logs",
      "title": "Egress proxy: misses and refusals",
      "id": 6,
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{host=\"egress01\", unit=\"docker.service\"} |~ `egress (would refuse|refused): client`",
          "refId": "A",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 17
      }
    },
    {
      "type": "row",
      "title": "UniFi: logged drops for the Agents zone (workspaces VLAN 30, AgentSvc VLAN 31)",
      "id": 7,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      }
    },
    {
      "type": "timeseries",
      "title": "Drops by rule",
      "description": "UniFi truncates rule names in its log. 'internet on\u2026' = direct internet (should go through the proxy); 'nothing else on gateway' = anything but DNS to the gateway; 'log + block new -> <zone>' = lateral movement attempts.",
      "id": 8,
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (rule) (count_over_time({job=\"syslog\", source=\"unifi\"} |= `DESCR=\"Agents:` | regexp `DESCR=\"(?P<rule>[^\"]*)\"` [$__interval]))",
          "refId": "A",
          "legendFormat": "{{rule}}",
          "queryType": "range"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      }
    },
    {
      "type": "table",
      "title": "Top dropped flows",
      "description": "",
      "id": 9,
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(30, sum by (rule, src, dst, proto, dpt) (count_over_time({job=\"syslog\", source=\"unifi\"} |= `DESCR=\"Agents:` | regexp `DESCR=\"(?P<rule>[^\"]*)\"` | regexp `SRC=(?P<src>\\S+) DST=(?P<dst>\\S+)` | regexp `PROTO=(?P<proto>\\S+)` | regexp `DPT=(?P<dpt>\\d+)` [$__range])))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "count"
            },
            "indexByName": {
              "rule": 0,
              "src": 1,
              "dst": 2,
              "proto": 3,
              "dpt": 4,
              "count": 5
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "count",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 34
      }
    },
    {
      "type": "logs",
      "title": "UniFi Agents drops",
      "id": 10,
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{job=\"syslog\", source=\"unifi\"} |= `DESCR=\"Agents:`",
          "refId": "A",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 43
      }
    },
    {
      "type": "row",
      "title": "Workspace VM firewalls (Proxmox): inbound drops",
      "id": 11,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 51
      }
    },
    {
      "type": "timeseries",
      "title": "Drops by VM",
      "description": "Workspaces log inbound policy drops (log_level_in in the Coder template), e.g. another workspace probing this one. VM 1000-1999 = workspaces.",
      "id": 12,
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (vmid) (count_over_time({job=\"syslog\", app=\"pve-firewall\"} |~ `policy (DROP|REJECT)` | regexp `^(?P<vmid>\\d+) ` [$__interval]))",
          "refId": "A",
          "legendFormat": "VM {{vmid}}",
          "queryType": "range"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 52
      }
    },
    {
      "type": "table",
      "title": "Top dropped flows",
      "description": "",
      "id": 13,
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(30, sum by (vmid, src, dst, proto, dpt) (count_over_time({job=\"syslog\", app=\"pve-firewall\"} |~ `policy (DROP|REJECT)` | regexp `^(?P<vmid>\\d+) \\d+ (?P<chain>\\S+) ` | regexp `SRC=(?P<src>\\S+) DST=(?P<dst>\\S+)` | regexp `PROTO=(?P<proto>\\S+)` | regexp `DPT=(?P<dpt>\\d+)` [$__range])))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "count"
            },
            "indexByName": {
              "vmid": 0,
              "src": 1,
              "dst": 2,
              "proto": 3,
              "dpt": 4,
              "count": 5
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "count",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 52
      }
    },
    {
      "type": "logs",
      "title": "PVE firewall drops",
      "id": 14,
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{job=\"syslog\", app=\"pve-firewall\"} |~ `policy (DROP|REJECT)`",
          "refId": "A",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 60
      }
    }
  ]
}