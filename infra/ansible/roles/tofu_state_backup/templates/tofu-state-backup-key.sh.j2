#!/bin/bash
# Managed by Ansible — do not edit manually.
#
# Ensure a read-only Garage key for the Tofu state bucket exists and that
# rclone is configured with it. The secret goes straight from `garage` into a
# root-only file and is never printed. Prints "ok" or "changed".
set -euo pipefail

CONF=/etc/tofu-state-backup/rclone.conf
KEY="{{ tofu_state_backup_key_name }}"
BUCKET="{{ tofu_state_backup_bucket }}"

node_id=$(garage node id -q | cut -d@ -f1)
g() { garage --rpc-host "${node_id}@{{ tofu_state_backup_garage_rpc }}" "$@"; }

# Already working? Then nothing to do.
if [ -s "$CONF" ] && rclone --config "$CONF" lsf "garage:${BUCKET}" --max-depth 1 >/dev/null 2>&1; then
  echo ok
  exit 0
fi

if ! g key info "$KEY" >/dev/null 2>&1; then
  g key create "$KEY" >/dev/null
fi
g bucket allow --read --key "$KEY" "$BUCKET" >/dev/null

info=$(g key info --show-secret "$KEY")
key_id=$(awk -F': *' '/^Key ID/ {print $2; exit}' <<<"$info")
secret=$(awk -F': *' '/^Secret key/ {print $2; exit}' <<<"$info")
unset info
if [ -z "$key_id" ] || [ -z "$secret" ]; then
  echo "could not read key $KEY from garage key info" >&2
  exit 1
fi

umask 077
install -d -m 0700 /etc/tofu-state-backup
tmp=$(mktemp /etc/tofu-state-backup/rclone.conf.XXXXXX)
cat >"$tmp" <<EOF
[garage]
type = s3
provider = Other
endpoint = {{ tofu_state_backup_s3_endpoint }}
region = {{ tofu_state_backup_s3_region }}
force_path_style = true
access_key_id = ${key_id}
secret_access_key = ${secret}
EOF
unset secret
mv "$tmp" "$CONF"

rclone --config "$CONF" lsf "garage:${BUCKET}" --max-depth 1 >/dev/null
echo changed
