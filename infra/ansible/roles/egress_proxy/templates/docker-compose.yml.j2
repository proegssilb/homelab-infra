# Managed by Ansible — do not edit manually
services:
  mitmproxy:
    image: mitmproxy/mitmproxy:{{ egress_proxy_version }}
    container_name: egress-proxy
    restart: unless-stopped
    # block_global=false: mitmproxy otherwise refuses clients from non-local
    # addresses. Who may connect is decided by egress01's VM firewall
    # (workspace subnet only, tofu/pets/agentsvc.tf) and UniFi.
    command:
      - mitmdump
      - --mode
      - regular@8080
{% for pattern in egress_proxy_ignore_hosts %}
      - --ignore-hosts
      - "{{ pattern }}"
{% endfor %}
      - --set
      - block_global=false
      # Destination allowlist, before block_private.py (which replaces the
      # hostname with the vetted IP).
      - -s
      - /addons/allowlist.py
      - --set
      - egress_allowlist=/addons/allowlist.txt
      - --set
      - egress_allowlist_mode={{ egress_proxy_allowlist_mode }}
      # Refuse every non-public destination (lab services egress01 can reach).
      - -s
      - /addons/block_private.py
    # Without a TTY Python block-buffers stdout, so log lines reached the
    # journal (and Loki) only in batches or when the container stopped.
    environment:
      PYTHONUNBUFFERED: "1"
    ports:
      - "{{ egress_proxy_port }}:8080"
    volumes:
      - {{ egress_proxy_data_dir }}/addons:/addons:ro
    # To the journal, which Alloy ships to Loki.
    logging:
      driver: journald
      options:
        tag: egress-proxy
