# Managed by Ansible — do not edit by hand.
# Role: nginx_reverse_proxy

user www-data;
worker_processes auto;
pid /run/nginx.pid;
include /etc/nginx/modules-enabled/*.conf;

events {
  worker_connections 1024;
}

http {
  sendfile on;
  tcp_nopush on;
  types_hash_max_size 2048;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  # Logging
  access_log /var/log/nginx/access.log;
  error_log  /var/log/nginx/error.log;

  # TLS defaults — individual vhosts set their own cert/key paths.
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;

  # Resolve upstream hostnames at request time so nginx starts cleanly even
  # when backend VMs are not yet provisioned (e.g. during a DR bootstrap).
  resolver {{ nginx_resolver }} valid=30s ipv6=off;

  # Proxy timeouts suited for Proxmox console sessions (noVNC/SPICE).
  proxy_connect_timeout 10s;
  proxy_send_timeout    300s;
  proxy_read_timeout    300s;

  # Include per-vhost config files.
  include /etc/nginx/conf.d/*.conf;
}
