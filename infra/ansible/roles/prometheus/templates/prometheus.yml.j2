global:
  scrape_interval: 60s
  evaluation_interval: 60s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['localhost:9093']

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node_exporter
    file_sd_configs:
      - files:
          - {{ prometheus_config_dir }}/targets/proxmox.json
        refresh_interval: 5m

  - job_name: unpoller
    static_configs:
      - targets: ['localhost:9130']

  - job_name: graphite
    static_configs:
      - targets: ['localhost:9108']

  - job_name: static
    file_sd_configs:
      - files:
          - {{ prometheus_config_dir }}/targets/static.yml
{% if prometheus_blackbox_vhosts | length > 0 %}

  - job_name: blackbox_http
    metrics_path: /probe
    static_configs:
{% for vhost in prometheus_blackbox_vhosts %}
      - targets: ['https://{{ vhost.server_name }}/']
        labels:
          __param_module: {{ vhost.probe_module | default('http_2xx') }}
          target: {{ vhost.name }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: {{ prometheus_blackbox_address }}
{% endif %}
