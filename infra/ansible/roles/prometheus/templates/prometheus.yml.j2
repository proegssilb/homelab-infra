global:
  scrape_interval: 60s
  evaluation_interval: 60s

# OTLP push (--web.enable-otlp-receiver): Proxmox's OpenTelemetry metric server
# (tofu/platform/proxmox_metrics.tf). Its unit metadata is unreliable (the same
# value arrives as _bytes and _seconds, _percent and _ratio), and Prometheus
# would otherwise append the unit to the name, splitting one stat into several
# series. Without suffixes each stat keeps one name.
otlp:
  translation_strategy: UnderscoreEscapingWithoutSuffixes

rule_files:
  - {{ prometheus_config_dir }}/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['localhost:9093']

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node_exporter
    file_sd_configs:
      - files:
          - {{ prometheus_config_dir }}/targets/proxmox.json
        refresh_interval: 5m

{% if groups.get('bootstrap') %}
  # blade02 and other bootstrap nodes: not Proxmox guests, so proxmox SD misses
  # them. Carries the Tofu state backup's success metric.
  - job_name: bootstrap
    static_configs:
      - targets:
{% for h in groups['bootstrap'] %}
          - '{{ h }}.{{ homelab_domain }}:9100'
{% endfor %}

{% endif %}
{% if groups.get('hypervisors') %}
  # Proxmox nodes: Debian's node_exporter (hypervisors.yml). Static, from the
  # inventory's hypervisors group; they aren't guests, so proxmox SD misses them.
  - job_name: hypervisors
    static_configs:
      - targets:
{% for h in groups['hypervisors'] %}
          - '{{ h }}.{{ homelab_domain }}:9100'
{% endfor %}
    # Full names: not every node's short name resolves from obs01. The
    # instance label keeps the short name.
    relabel_configs:
      - source_labels: [__address__]
        regex: '([^.:]+)[.:].*'
        target_label: instance
        replacement: '$1'

{% endif %}
{% if prometheus_ceph_mgr_hosts | length > 0 %}
  # Ceph's built-in mgr exporter. Only the active mgr serves metrics; a standby
  # answers 200 with an empty body, so both targets are up and nothing is
  # duplicated. honor_labels: Ceph sets its own labels.
  - job_name: ceph
    honor_labels: true
    static_configs:
      - targets:
{% for h in prometheus_ceph_mgr_hosts %}
          - '{{ h }}.{{ homelab_domain }}:9283'
{% endfor %}

{% endif %}
{% if groups.get('coder_app') %}
  # Coder's own metrics (workspace builds, agents, API). Port opened to obs01
  # in tofu/pets/coder_firewall.tf.
  - job_name: coder
    static_configs:
      - targets:
{% for h in groups['coder_app'] %}
          - '{{ h }}.{{ homelab_domain }}:{{ hostvars[h].coder_prometheus_port | default(2112) }}'
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        regex: '([^.:]+)[.:].*'
        target_label: instance
        replacement: '$1'

{% endif %}
  - job_name: unpoller
    static_configs:
      - targets: ['localhost:9130']

  - job_name: graphite
    static_configs:
      - targets: ['localhost:9108']

{% if prometheus_ups_targets | length > 0 %}
  # UPS network cards over SNMPv3, through snmp_exporter on this host. Each
  # card names its own module (standard UPS-MIB or a vendor MIB); the
  # instance label is the card's name, not its address. Old cards answer
  # slowly, hence the longer timeout.
  - job_name: ups
    metrics_path: /snmp
    scrape_timeout: 30s
    params:
      auth: [{{ prometheus_ups_auth_name }}]
    static_configs:
{% for t in prometheus_ups_targets %}
      - targets: [{{ t.address | to_json }}]
        labels:
          __param_module: {{ t.module | to_json }}
          instance: {{ t.name | to_json }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - target_label: __address__
        replacement: {{ prometheus_snmp_exporter_address }}

{% endif %}
{% if prometheus_nut_targets | length > 0 %}
  # USB UPSes through NUT: nut_exporter runs on the host the UPS is plugged
  # into. The instance label is the UPS's name, not the exporter host.
  - job_name: ups_nut
    metrics_path: /ups_metrics
    static_configs:
{% for t in prometheus_nut_targets %}
      - targets: [{{ t.address | to_json }}]
        labels:
          __param_ups: {{ t.ups | to_json }}
          instance: {{ t.name | to_json }}
{% endfor %}

{% endif %}
  - job_name: static
    file_sd_configs:
      - files:
          - {{ prometheus_config_dir }}/targets/static.yml
{% if prometheus_blackbox_vhosts | length > 0 %}

  - job_name: blackbox_http
    metrics_path: /probe
    static_configs:
{% for vhost in prometheus_blackbox_vhosts %}
      - targets: ['https://{{ vhost.server_name }}/']
        labels:
          __param_module: {{ vhost.probe_module | default('http_2xx') }}
          target: {{ vhost.name }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: {{ prometheus_blackbox_address }}
{% endif %}
