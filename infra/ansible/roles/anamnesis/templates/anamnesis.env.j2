# {{ anamnesis_config_dir }}/anamnesis.env — installed 0640 root:anamnesis.
#
# systemd parses this itself, not a shell: no `export`, no command
# substitution, and no quotes unless you want the quotes in the value.

# --- Database ---------------------------------------------------------------
# pg01 (postgresql role) does not terminate TLS, matching every other app in
# this repo (see mealie/freshrss) — no sslmode param, so sqlx negotiates
# whatever the server offers instead of demanding TLS it can't provide.
ANAMNESIS_DATABASE_URL=postgres://anamnesis:{{ anamnesis_db_pass | trim }}@{{ anamnesis_db_host }}/anamnesis

# --- Networking -------------------------------------------------------------
# Upstream's example binds loopback because it assumes nginx runs on the same
# host. Here the reverse proxy is a separate LXC (proxy01) that connects over
# the LAN to anamnesis.{{ homelab_domain }}:8080, so this must be 0.0.0.0.
ANAMNESIS_BIND_ADDR=0.0.0.0:8080
ANAMNESIS_BASE_URL=https://tasks.{{ homelab_domain }}

# --- Storage ----------------------------------------------------------------
# Garage (garage-apps host) — bucket + key auto-provisioned by
# `garage server --single-node --default-bucket`, see host_vars/garage-apps.yml.
ANAMNESIS_BLOB_ROOT=s3://anamnesis/blobs
ANAMNESIS_S3_ACCESS_KEY_ID={{ anamnesis_s3_access_key_id | trim }}
ANAMNESIS_S3_SECRET_ACCESS_KEY={{ anamnesis_s3_secret_access_key | trim }}
ANAMNESIS_S3_ENDPOINT=https://s3.{{ homelab_domain }}
# Garage's s3_region is hardcoded to "garage" (see garage.toml.j2), not the
# S3-style default of us-east-1.
ANAMNESIS_S3_REGION=garage

# --- OpenID Connect ---------------------------------------------------------
ANAMNESIS_OIDC_ISSUER_URL={{ anamnesis_oidc_issuer_url }}
ANAMNESIS_OIDC_CLIENT_ID=anamnesis
ANAMNESIS_OIDC_CLIENT_SECRET={{ anamnesis_oidc_client_secret | trim }}
ANAMNESIS_OIDC_ADMIN_GROUP=anamnesis-admins
ANAMNESIS_OIDC_GROUPS_CLAIM=groups

# --- Sessions ---------------------------------------------------------------
# At least 64 bytes, generated ONCE and kept: rotating it logs every user out.
ANAMNESIS_SESSION_SECRET={{ anamnesis_session_secret | trim }}

# --- Time zone and first admin ----------------------------------------------
ANAMNESIS_TIMEZONE={{ anamnesis_timezone }}
ANAMNESIS_BOOTSTRAP_ADMIN={{ anamnesis_bootstrap_admin }}

# --- Optional ---------------------------------------------------------------
RUST_LOG=info
