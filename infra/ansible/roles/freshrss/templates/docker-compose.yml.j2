---
# Managed by Ansible — do not edit manually
services:
  freshrss:
    image: freshrss/freshrss:{{ freshrss_version }}
    restart: unless-stopped
    ports:
      - "{{ freshrss_port }}:80"
    volumes:
      - {{ freshrss_data_dir }}/data:/var/www/FreshRSS/data
      - {{ freshrss_data_dir }}/extensions:/var/www/FreshRSS/extensions
    environment:
      TZ: UTC
      CRON_MIN: "*/15"
      FRESHRSS_INSTALL: |-
        --api-enabled
        --default-user {{ freshrss_admin_user }}
        --base-url {{ freshrss_base_url }}
        --db-host {{ freshrss_db_host }}
        --db-base {{ freshrss_db_name }}
        --db-user {{ freshrss_db_user }}
        --db-password {{ freshrss_db_pass | trim }}
        --db-type pgsql
      FRESHRSS_USER: |-
        --user {{ freshrss_admin_user }}
      OIDC_ENABLED: 1
      OIDC_PROVIDER_METADATA_URL: "{{ freshrss_oidc_issuer_url }}.well-known/openid-configuration"
      OIDC_CLIENT_ID: "{{ freshrss_oidc_client_id }}"
      OIDC_CLIENT_SECRET: "{{ freshrss_oidc_client_secret }}"
      OIDC_SCOPES: "openid email profile"
      OIDC_REMOTE_USER_CLAIM: preferred_username
      OIDC_X_FORWARDED_HEADERS: X-Forwarded-Proto
