[Unit]
Description=Blackbox Exporter
After=network.target

[Service]
Type=simple
User=blackbox_exporter
ExecStart={{ blackbox_exporter_install_dir }}/blackbox_exporter \
  --config.file={{ blackbox_exporter_config_dir }}/blackbox.yml \
  --web.listen-address={{ blackbox_exporter_http_listen }}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
