# Grafana's RPM repo, for Alloy. The signing key is committed next to this file
# (fingerprint B53A E77B ADB6 30A6 8304 6005 963F A277 1045 8545, expires
# 2027-08-22) rather than fetched at build time.
[grafana]
name=grafana
baseurl=https://rpm.grafana.com
repo_gpgcheck=1
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-grafana
sslverify=1
