#!/usr/bin/python3
"""node_exporter textfile metrics for bootc:

  bootc_booted_image_info{image,channel,digest,version} 1
      The image this VM booted; channel is the tag of the image it *tracks*
      (canary/stable after cloud-init's first-boot switch).
  bootc_update_available 0|1
      1 when the tracked tag points at something newer than what's booted, or an
      update is staged and waiting for the window. Stuck at 1 for long means a
      failed update or a rollback (alert BootcUpdateStuck).

Runs at boot and hourly. The registry check needs the network; if it fails,
only the booted-image metric is written. Atomic write (temp + rename).
"""
import json
import os
import subprocess

OUT_DIR = "/var/lib/prometheus/node-exporter"
OUT = os.path.join(OUT_DIR, "bootc_image.prom")


def esc(v: str) -> str:
    return v.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")


def status() -> dict:
    return json.loads(subprocess.run(["bootc", "status", "--json"], check=True,
                                     capture_output=True, text=True).stdout)


def get(d, *path):
    for p in path:
        d = (d or {}).get(p)
    return d


# Refresh the cached "is there an update" answer; tolerate no network / no registry.
checked = subprocess.run(["bootc", "upgrade", "--check", "--quiet"],
                         capture_output=True, text=True).returncode == 0

st = status()
booted = get(st, "status", "booted", "image") or {}
booted_digest = booted.get("imageDigest") or "unknown"
tracked = get(st, "spec", "image", "image") or get(booted, "image", "image") or "unknown"
channel = tracked.rsplit(":", 1)[1] if ":" in tracked.rsplit("/", 1)[-1] and "@" not in tracked else "none"

labels = {
    "image": get(booted, "image", "image") or "unknown",
    "channel": channel,
    "digest": booted_digest,
    "version": booted.get("version") or "unknown",
}
lines = [
    "# HELP bootc_booted_image_info The bootc image this VM booted, and the channel it tracks.",
    "# TYPE bootc_booted_image_info gauge",
    "bootc_booted_image_info{%s} 1" % ",".join(f'{k}="{esc(v)}"' for k, v in labels.items()),
]

staged = get(st, "status", "staged", "image", "imageDigest")
cached = get(st, "status", "booted", "cachedUpdate", "imageDigest")
if checked or staged:
    pending = bool(staged and staged != booted_digest) or bool(cached and cached != booted_digest)
    lines += [
        "# HELP bootc_update_available 1 if the tracked tag is newer than the booted image or an update is staged.",
        "# TYPE bootc_update_available gauge",
        f"bootc_update_available {int(pending)}",
    ]

os.makedirs(OUT_DIR, exist_ok=True)
tmp = OUT + ".tmp"
with open(tmp, "w") as fh:
    fh.write("\n".join(lines) + "\n")
os.chmod(tmp, 0o644)
os.replace(tmp, OUT)
