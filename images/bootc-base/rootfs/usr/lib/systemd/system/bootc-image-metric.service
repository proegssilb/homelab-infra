[Unit]
Description=Publish bootc image and update status as node_exporter textfile metrics
# Feeds canary promotion, the per-VM image panel and BootcUpdateStuck.
Wants=network-online.target
After=network-online.target systemd-tmpfiles-setup.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/bootc-image-metric

[Install]
WantedBy=multi-user.target
